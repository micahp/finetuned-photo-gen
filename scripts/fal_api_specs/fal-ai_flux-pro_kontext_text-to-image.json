{
  "openapi": "3.0.4",
  "info": {
    "title": "Queue OpenAPI for fal-ai/flux-pro/kontext/text-to-image",
    "version": "1.0.0",
    "description": "The OpenAPI schema for the fal-ai/flux-pro/kontext/text-to-image queue.",
    "x-fal-metadata": {
      "endpointId": "fal-ai/flux-pro/kontext/text-to-image",
      "category": "text-to-image",
      "thumbnailUrl": "https://v3b.fal.media/files/b/0a9f91ad/tawaEEjSMOh_9TnYUkmy0_dDkJYEiR.png",
      "playgroundUrl": "https://fal.ai/models/fal-ai/flux-pro/kontext/text-to-image",
      "documentationUrl": "https://fal.ai/models/fal-ai/flux-pro/kontext/text-to-image/api",
      "about": "FLUX.1 Kontext [pro] -- Frontier image generation model."
    }
  },
  "components": {
    "securitySchemes": {
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Fal Key"
      }
    },
    "schemas": {
      "QueueStatus": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "IN_QUEUE",
              "IN_PROGRESS",
              "COMPLETED"
            ]
          },
          "request_id": {
            "type": "string",
            "description": "The request id."
          },
          "response_url": {
            "type": "string",
            "description": "The response url."
          },
          "status_url": {
            "type": "string",
            "description": "The status url."
          },
          "cancel_url": {
            "type": "string",
            "description": "The cancel url."
          },
          "logs": {
            "type": "object",
            "description": "The logs.",
            "additionalProperties": true
          },
          "metrics": {
            "type": "object",
            "description": "The metrics.",
            "additionalProperties": true
          },
          "queue_position": {
            "type": "integer",
            "description": "The queue position."
          }
        },
        "required": [
          "status",
          "request_id"
        ]
      },
      "FluxProKontextTextToImageInput": {
        "properties": {
          "safety_tolerance": {
            "enum": [
              "1",
              "2",
              "3",
              "4",
              "5",
              "6"
            ],
            "default": "2",
            "title": "Safety Tolerance",
            "type": "string",
            "description": "The safety tolerance level for the generated image. 1 being the most strict and 5 being the most permissive."
          },
          "prompt": {
            "title": "Prompt",
            "examples": [
              "Extreme close-up of a single tiger eye, direct frontal view. Detailed iris and pupil. Sharp focus on eye texture and color. Natural lighting to capture authentic eye shine and depth. The word \"FLUX\" is painted over it in big, white brush strokes with visible texture."
            ],
            "type": "string",
            "description": "The prompt to generate an image from."
          },
          "output_format": {
            "enum": [
              "jpeg",
              "png"
            ],
            "default": "jpeg",
            "title": "Output Format",
            "type": "string",
            "description": "The format of the generated image."
          },
          "seed": {
            "title": "Seed",
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "\n            The same seed and the same prompt given to the same version of the model\n            will output the same image every time.\n        "
          },
          "num_images": {
            "type": "integer",
            "default": 1,
            "title": "Num Images",
            "minimum": 1,
            "maximum": 4,
            "description": "The number of images to generate."
          },
          "enhance_prompt": {
            "title": "Enhance Prompt",
            "default": false,
            "type": "boolean",
            "description": "Whether to enhance the prompt for better results."
          },
          "sync_mode": {
            "title": "Sync Mode",
            "default": false,
            "type": "boolean",
            "description": "If `True`, the media will be returned as a data URI and the output data won't be available in the request history."
          },
          "guidance_scale": {
            "type": "number",
            "default": 3.5,
            "title": "Guidance scale (CFG)",
            "minimum": 1,
            "maximum": 20,
            "description": "\n            The CFG (Classifier Free Guidance) scale is a measure of how close you want\n            the model to stick to your prompt when looking for a related image to show you.\n        "
          },
          "aspect_ratio": {
            "enum": [
              "21:9",
              "16:9",
              "4:3",
              "3:2",
              "1:1",
              "2:3",
              "3:4",
              "9:16",
              "9:21"
            ],
            "default": "1:1",
            "title": "Aspect Ratio",
            "type": "string",
            "description": "The aspect ratio of the generated image."
          }
        },
        "x-fal-order-properties": [
          "prompt",
          "seed",
          "guidance_scale",
          "sync_mode",
          "num_images",
          "output_format",
          "safety_tolerance",
          "enhance_prompt",
          "aspect_ratio"
        ],
        "required": [
          "prompt"
        ],
        "type": "object",
        "title": "FluxProTextToImageInputWithAR"
      },
      "FluxProKontextTextToImageOutput": {
        "properties": {
          "prompt": {
            "title": "Prompt",
            "type": "string",
            "description": "The prompt used for generating the image."
          },
          "has_nsfw_concepts": {
            "title": "Has Nsfw Concepts",
            "items": {
              "type": "boolean"
            },
            "type": "array",
            "description": "Whether the generated images contain NSFW concepts."
          },
          "seed": {
            "title": "Seed",
            "type": "integer",
            "description": "\n            Seed of the generated Image. It will be the same value of the one passed in the\n            input or the randomly generated that was used in case none was passed.\n        "
          },
          "timings": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Timings"
          },
          "images": {
            "title": "Images",
            "items": {
              "$ref": "#/components/schemas/registry__image__fast_sdxl__models__Image"
            },
            "type": "array",
            "description": "The generated image files info."
          }
        },
        "x-fal-order-properties": [
          "images",
          "timings",
          "seed",
          "has_nsfw_concepts",
          "prompt"
        ],
        "required": [
          "images",
          "timings",
          "seed",
          "has_nsfw_concepts",
          "prompt"
        ],
        "type": "object",
        "title": "Output"
      },
      "registry__image__fast_sdxl__models__Image": {
        "properties": {
          "height": {
            "type": "integer",
            "title": "Height"
          },
          "width": {
            "type": "integer",
            "title": "Width"
          },
          "url": {
            "type": "string",
            "title": "Url"
          },
          "content_type": {
            "default": "image/jpeg",
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Content Type"
          }
        },
        "x-fal-order-properties": [
          "url",
          "width",
          "height",
          "content_type"
        ],
        "required": [
          "url",
          "width",
          "height"
        ],
        "type": "object",
        "title": "Image"
      }
    }
  },
  "paths": {
